{
  "name": "walden",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:cloudflare": "node --env-file-if-exists=.env scripts/dev.mjs --cloudflare",
    "test:dev": "node --test scripts/dev.test.mjs && pnpm --filter @walden/web test src/lib/tests/vite-config.test.ts",
    "test:dev:smoke": "node scripts/dev-smoke.mjs",
    "test:providers": "node tests/provider-matrix/run.mjs",
    "test:providers:live": "playwright test --config tests/provider-matrix/live.config.ts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:ci": "biome ci --reporter=summary .",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @walden/api db:migrate",
    "verify": "pnpm typecheck && pnpm exec turbo run test --concurrency=1 && pnpm build",
    "db:generate": "pnpm --filter @walden/api db:generate",
    "db:check": "pnpm --filter @walden/api db:check",
    "build:self-hosted": "pnpm --filter @walden/contracts build && pnpm --filter @walden/domain build && pnpm --filter @walden/web build && pnpm --filter @walden/api build:node",
    "start:self-hosted": "node --env-file-if-exists=.env scripts/start-self-hosted.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.58.0",
    "turbo": "2.10.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.19.0"
  }
}
