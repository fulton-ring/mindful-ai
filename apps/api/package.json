{
  "name": "@walden/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev --env-file ../../.env --env-file .dev.vars --var CLERK_AUTHORIZED_PARTIES:http://localhost:5173,http://localhost:8787,http://localhost:8788,http://127.0.0.1:5173,http://127.0.0.1:8787,http://127.0.0.1:8788",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "dev:test": "wrangler dev --config wrangler.test.jsonc --env test --local --port 8788",
    "db:migrate:test": "wrangler d1 migrations apply walden-local-test --config wrangler.test.jsonc --env test --local"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.75",
    "@ai-sdk/provider": "^3.0.16",
    "@clerk/backend": "^2.17.0",
    "@mastra/cloudflare-d1": "1.3.2",
    "@mastra/core": "^1.67.0",
    "@mastra/mcp": "^1.18.0",
    "@mastra/memory": "1.30.0",
    "@mastra/observability": "^1.17.8",
    "@mastra/posthog": "^1.3.10",
    "@mastra/s3": "0.6.3",
    "@walden/contracts": "workspace:*",
    "@walden/domain": "workspace:*",
    "hono": "^4.9.7",
    "workers-ai-provider": "^3.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.38.0"
  }
}
