{
  "name": "@walden/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "node --env-file-if-exists=../../.env scripts/dev.mjs",
    "dev:cloudflare": "wrangler dev --env-file ../../.env --env-file .dev.vars --var APP_URL:http://localhost:8787 --var CLERK_AUTHORIZED_PARTIES:http://localhost:5173,http://localhost:8787,http://localhost:8788,http://127.0.0.1:5173,http://127.0.0.1:8787,http://127.0.0.1:8788",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "dev:test": "wrangler dev --config wrangler.test.jsonc --env test --local --port 8788",
    "db:migrate:test": "wrangler d1 migrations apply walden-local-test --config wrangler.test.jsonc --env test --local",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --env-file /dev/null",
    "test:live": "node --env-file=.env.live node_modules/vitest/vitest.mjs run src/agent/memory src/services",
    "test:search:live": "RUN_LIVE_AI_SEARCH=1 node --env-file=.env.live node_modules/vitest/vitest.mjs run src/services/research/tests/live-saved-sources.test.ts",
    "build:node": "node scripts/build-node.mjs",
    "start:node": "node dist/node/server.js",
    "cli": "node dist/node/cli.js"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.75",
    "@ai-sdk/provider": "^3.0.16",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@clerk/backend": "^2.17.0",
    "@hono/node-server": "2.1.5",
    "@huggingface/transformers": "4.3.1",
    "@mastra/ai-sdk": "1.10.5",
    "@mastra/cloudflare-d1": "1.4.3",
    "@mastra/core": "1.78.0",
    "@mastra/libsql": "1.26.2",
    "@mastra/mcp": "^1.18.0",
    "@mastra/memory": "1.30.0",
    "@mastra/observability": "^1.17.8",
    "@mastra/pg": "1.31.2",
    "@mastra/posthog": "^1.3.10",
    "@mastra/redis": "1.4.10",
    "@mastra/redis-streams": "0.6.3",
    "@walden/contracts": "workspace:*",
    "@walden/domain": "workspace:*",
    "ai": "6.0.286",
    "better-auth": "1.7.10",
    "drizzle-orm": "^0.45.2",
    "exceljs": "4.4.0",
    "hono": "^4.9.7",
    "ioredis": "5.8.2",
    "ipaddr.js": "2.5.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "playwright": "1.64.1",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "workers-ai-provider": "^3.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "@types/node": "^22.20.3",
    "@types/pg": "8.23.1",
    "@types/turndown": "5.0.6",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.38.0"
  },
  "files": [
    "dist/node",
    "public",
    "migrations",
    "postgres-migrations"
  ],
  "engines": {
    "node": ">=24.15.0"
  }
}
