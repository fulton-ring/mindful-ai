{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "walden",
  "preview_urls": false,
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  // @mastra/cloudflare-d1 imports the `cloudflare` REST SDK only for its
  // apiToken mode; the D1 binding path never constructs it.
  "alias": { "cloudflare": "./stubs/cloudflare.ts" },
  "limits": {
    "cpu_ms": 30000
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "walden",
      "database_id": "18072abe-34d0-4972-9ef6-d955ca0d6896",
      "migrations_dir": "migrations"
    }
  ],
  // One object per chat turn: runs the turn detached from any request and
  // streams its chunks to every reader.
  "durable_objects": {
    "bindings": [{ "name": "CHAT_TURN", "class_name": "ChatTurn" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatTurn"] }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "walden-attachments" }],
  "ai": {
    "binding": "AI",
    // Workers AI has no local emulation. Declaring the remote binding up front
    // keeps wrangler from restarting the dev server to negotiate the proxy,
    // which otherwise kills in-flight SSE streams mid-response.
    "remote": true
  },
  // Web reading and source search. Both have no local emulation, so they are
  // declared remote up front for the same reason as the AI binding above.
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "default",
      "remote": true
    }
  ],
  "triggers": {
    "crons": ["* * * * *", "17 * * * *"]
  },
  "vars": {
    "AI_PROVIDER": "cloudflare",
    "AI_MODEL": "@cf/zai-org/glm-5.3-flash",
    "R2_ACCOUNT_ID": "e9be35217a75f5d2148e572d8853b3bf",
    "R2_BUCKET": "walden-attachments",
    "CLOUDFLARE_ACCOUNT_ID": "e9be35217a75f5d2148e572d8853b3bf",
    "POSTHOG_PROJECT_ID": "619294",
    "CLERK_PUBLISHABLE_KEY": "pk_test_bW9yYWwtbGVtdXItNjI4Mi5jbGVyay5hY2NvdW50cy5kZXYk",
    "CLERK_AUTHORIZED_PARTIES": "http://localhost:5173,http://localhost:8788,http://localhost:8787,http://127.0.0.1:5173,http://127.0.0.1:8788,http://127.0.0.1:8787,https://walden.jeremy-herzog.workers.dev",
    "AI_SEARCH_INSTANCE": "mindful-ai-sources",
    "MESSAGE_LIMIT": "20",
    "MESSAGE_WINDOW_HOURS": "4"
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "account_id": "e9be35217a75f5d2148e572d8853b3bf",
  "minify": true
}
