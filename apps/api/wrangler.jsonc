{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "walden",
  "preview_urls": false,
  "main": "src/worker.ts",
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  // Portable Cloudflare example: authenticate Wrangler with your own account and
  // create the resources below before deploying. See docs/runbooks/credentials.md.
  // Add your own custom-domain routes if needed; workers.dev remains available.
  "workers_dev": true,
  // @mastra/cloudflare-d1 imports the `cloudflare` REST SDK only for its
  // apiToken mode; the D1 binding path never constructs it.
  "alias": { "cloudflare": "./stubs/cloudflare.ts" },
  "limits": {
    "cpu_ms": 30000
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "walden",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // One object per chat turn: runs the turn detached from any request and
  // streams its chunks to every reader.
  "durable_objects": {
    "bindings": [{ "name": "CHAT_TURN", "class_name": "ChatTurn" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatTurn"] }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "walden-attachments" }],
  "ai": {
    "binding": "AI",
    // Workers AI has no local emulation. Declaring the remote binding up front
    // keeps wrangler from restarting the dev server to negotiate the proxy,
    // which otherwise kills in-flight SSE streams mid-response.
    "remote": true
  },
  // Web reading and source search. Both have no local emulation, so they are
  // declared remote up front for the same reason as the AI binding above.
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "default",
      "remote": true
    }
  ],
  "triggers": {
    "crons": ["* * * * *", "17 * * * *"]
  },
  // Remote AI, browser and search bindings require your own Cloudflare access.
  // Configure inference, optional auth, source-index and R2 upload settings for
  // your deployment; keep secret values in .dev.vars or Wrangler secrets.
  "vars": {
    "AUTH_MODE": "none",
    "MESSAGE_LIMIT": "20",
    "MESSAGE_WINDOW_HOURS": "4"
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "minify": true
}
