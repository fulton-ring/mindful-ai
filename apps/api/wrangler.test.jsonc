{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "walden-local-test",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "env": {
    "test": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "walden-local-test",
          "database_id": "local-test",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "walden-attachments-test" }],
      // Document extraction uses Workers AI toMarkdown, which has no local emulation.
      "ai": { "binding": "AI", "remote": true },
      "durable_objects": {
        "bindings": [{ "name": "CHAT_TURN", "class_name": "ChatTurn" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatTurn"] }],
      "vars": {
        "UPLOAD_LOCAL_FALLBACK": "true"
      }
    }
  }
}
