---
import { COMPANY } from '../site';

const year = new Date().getFullYear();
---

<footer class="legal">
  <nav aria-label="Legal">
    <a href={COMPANY.terms}>Terms of Service</a>
    <a href={COMPANY.privacy}>Privacy Policy</a>
    <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
  </nav>
  <p>© {year} <a href={COMPANY.site}>{COMPANY.name}</a></p>
</footer>

<style>
  /* One item per line, so the links never wrap into each other on a phone. */
  .legal,
  .legal nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .legal {
    gap: 12px;
    margin-top: 28px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.4;
  }

  .legal a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .legal a:hover {
    color: var(--ink);
  }

  .legal p {
    margin: 0;
  }
</style>
