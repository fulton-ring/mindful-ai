---
import LegalFooter from '../components/LegalFooter.astro';
import Mark from '../components/Mark.astro';
import Base from '../layouts/Base.astro';
import { APP_URL } from '../site';

// Each beat is one stop on the walk around the pond and one feature of Walden; the
// scene frames that feature's shape on the side opposite the text.
const beats = [
  { id: 'welcome', label: 'Welcome' },
  { id: 'brevity', label: 'Short answers' },
  { id: 'highlights', label: 'Highlights' },
  { id: 'notes', label: 'Notes' },
  { id: 'personas', label: 'Personas' },
  { id: 'quizzes', label: 'Quizzes' },
  { id: 'begin', label: 'Notes stay' },
];
---

<Base>
  <canvas id="pond" aria-hidden="true"></canvas>

  <header class="bar">
    <a class="logo" href="#welcome" data-beat-link aria-label="Walden, back to the start">
      <Mark size={34} />
      Walden
    </a>
    <a class="pill" href={APP_URL}>Open Walden</a>
  </header>

  <main>
    <section class="beat" id="welcome" data-side="left" aria-label="Welcome">
      <div class="card">
        <h1>Walden</h1>
        <svg
          class="underline"
          viewBox="0 0 220 18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3 11 C 50 4, 90 15, 130 8 S 200 6, 217 10"></path>
        </svg>
        <p class="lede">A quiet place to think.</p>
        <p class="hint">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M12 4v16M6 14l6 6 6-6"></path></svg
          >
          Scroll to walk around the pond
        </p>
      </div>
    </section>

    <section class="beat" id="brevity" data-side="right" aria-label="Short answers">
      <div class="card">
        <h2>Short answers. Room to think.</h2>
        <p>Walden gets to the point. Want more? Just ask.</p>
      </div>
    </section>

    <section class="beat" id="highlights" data-side="right" aria-label="Highlights">
      <div class="card">
        <h2>What matters, marked.</h2>
        <p>Facts, claims, and assumptions highlighted in each reply.</p>
      </div>
    </section>

    <section class="beat" id="notes" data-side="left" aria-label="Notes">
      <div class="card">
        <h2>Write it in your own words.</h2>
        <p>AI tends to say too much. Taking notes slows you down, so you keep only what you understand.</p>
      </div>
    </section>

    <section class="beat" id="personas" data-side="right" aria-label="Personas">
      <div class="card">
        <h2>Pick your thinking partner.</h2>
        <p>A mentor, a challenger, a study partner, or one of your own.</p>
      </div>
    </section>

    <section class="beat" id="quizzes" data-side="left" aria-label="Quizzes">
      <div class="card">
        <h2>Check your knowledge.</h2>
        <div class="chat">
          <p class="say me">Quiz me on photosynthesis.</p>
          <p class="say them">Where does a leaf's oxygen come from?</p>
          <p class="say me">Carbon dioxide?</p>
          <p class="say them">Not quite. It comes from water, split by light. Another?</p>
        </div>
      </div>
    </section>

    <section class="beat" id="begin" data-side="left" aria-label="Notes stay">
      <div class="card">
        <h2>Conversations fade. Notes stay.</h2>
        <p>Chats clear after a week, so what lasts is what you understood.</p>
        <a class="pill solid" href={APP_URL}>Start thinking</a>
        <LegalFooter />
      </div>
    </section>
  </main>

  <nav class="rail" aria-label="Walk progress">
    {
      beats.map((beat) => (
        <a href={`#${beat.id}`} data-beat-link aria-label={beat.label}>
          <span />
        </a>
      ))
    }
  </nav>
</Base>

<script>
  import { startStory } from '../scripts/story';

  const story = startStory();
  const canvas = document.querySelector<HTMLCanvasElement>('#pond');
  // The scene is decoration: load it after the words are on screen, and keep the
  // page fully readable if WebGL is missing.
  if (canvas)
    import('../scripts/pond/world')
      .then(({ startWorld }) => startWorld(canvas, story))
      .catch(() => canvas.remove());
</script>

<style>
  #pond {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
  }

  .bar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 5;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: calc(env(safe-area-inset-top, 0px) + 18px)
      calc(env(safe-area-inset-right, 0px) + 22px) 14px
      calc(env(safe-area-inset-left, 0px) + 22px);
    pointer-events: none;
  }

  .bar > * {
    pointer-events: auto;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    /* The app sidebar's wordmark: IBM Plex Sans, semibold, at body size. */
    font-family: "IBM Plex Sans", sans-serif;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s;
  }

  .logo.shown {
    opacity: 1;
    visibility: visible;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 20px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    color: var(--ink);
    font-weight: 500;
    font-size: 16px;
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .pill:hover,
  .pill.solid {
    background: var(--ink);
    color: var(--paper);
  }

  .pill.solid {
    margin-top: 26px;
  }

  .pill.solid:hover {
    background: transparent;
    color: var(--ink);
  }

  main {
    position: relative;
    z-index: 2;
  }

  .beat {
    display: flex;
    align-items: center;
    min-height: 135vh;
    padding: 110px calc(env(safe-area-inset-right, 0px) + 84px) 110px
      calc(env(safe-area-inset-left, 0px) + 7vw);
  }

  .beat[data-side="right"] {
    justify-content: flex-end;
  }

  .beat:last-child {
    min-height: 115vh;
  }

  .card {
    max-width: 470px;
    /* A nearly solid ground, padded so the text sits well inside it, with the
       scene softly blurred behind and a glow that fades the edge into it. */
    padding: 28px 32px;
    margin: -28px -32px;
    background: var(--halo);
    box-shadow: 0 0 48px 32px var(--halo);
    border-radius: 40px;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    will-change: opacity, transform;
  }

  h1,
  h2 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
  }

  h1 {
    font-size: clamp(76px, 11vw, 136px);
    line-height: 0.85;
    letter-spacing: -0.02em;
  }

  h2 {
    margin-bottom: 14px;
    font-size: clamp(34px, 3.8vw, 46px);
    line-height: 1.05;
  }

  .card p {
    margin: 0;
    color: var(--muted);
  }

  .card p + p {
    margin-top: 12px;
  }

  .underline {
    display: block;
    width: 220px;
    height: 18px;
    margin: 4px 0 18px;
  }

  .card .lede {
    color: var(--ink);
    font-size: 21px;
  }

  .card .hint {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 26px;
    font-size: 15px;
  }

  .chat {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 6px;
  }

  .card .say {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }

  .card .say.shown {
    opacity: 1;
    transform: none;
  }

  .card .me {
    align-self: flex-end;
    max-width: 85%;
    text-align: right;
    font-size: 16.5px;
  }

  .card .them {
    align-self: flex-start;
    max-width: 92%;
    color: var(--ink);
    font-family: var(--serif);
    font-style: italic;
    font-size: 24px;
    line-height: 1.2;
  }


  .rail {
    position: fixed;
    z-index: 5;
    top: 50%;
    right: calc(env(safe-area-inset-right, 0px) + 12px);
    display: flex;
    flex-direction: column;
    transform: translateY(-50%);
  }

  .rail a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 40px;
  }

  .rail span {
    width: 9px;
    height: 9px;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .rail a[aria-current="step"] span {
    background: var(--ink);
    transform: scale(1.3);
  }

  @media (prefers-reduced-motion: reduce) {
    .card .say,
    .logo {
      transition: none;
    }
  }

  @media (max-width: 720px) {
    .beat,
    .beat[data-side="right"] {
      align-items: flex-end;
      justify-content: flex-start;
      min-height: 150vh;
      /* The section's bottom sits 25vh below the screen when its centre is in view;
         this lifts the card to the lower part of the screen, under the shape. */
      padding: 96px calc(env(safe-area-inset-right, 0px) + 56px)
        calc(env(safe-area-inset-bottom, 0px) + 31vh) calc(env(safe-area-inset-left, 0px) + 22px);
    }

    /* The first beat is read at the very top of the page rather than centred, so
       it is one screen tall and its card sits in view on load. */
    .beat:first-child {
      min-height: 100vh;
      min-height: 100svh;
      padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 9svh);
    }

    .card {
      max-width: none;
      padding: 22px 22px;
      margin: -22px -22px;
      box-shadow: 0 0 32px 24px var(--halo);
    }
  }
</style>
