{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Assets-only Worker for the Astro build. Authenticate Wrangler with your own
  // Cloudflare account; add your own custom-domain routes if needed.
  "name": "walden-landing",
  "compatibility_date": "2026-09-18",
  "preview_urls": false,
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
