{
  "$schema": "node_modules/wrangler/config-schema.json",
  // An assets-only Worker: no script, just the Astro build. The app itself is the
  // `walden` Worker in apps/api, served at chat.withwalden.app.
  "name": "walden-landing",
  "compatibility_date": "2026-09-18",
  "preview_urls": false,
  "workers_dev": true,
  "routes": [
    { "pattern": "withwalden.app", "custom_domain": true },
    { "pattern": "www.withwalden.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "account_id": "e9be35217a75f5d2148e572d8853b3bf"
}
