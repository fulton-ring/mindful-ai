# Where app buttons and legal links point. Defaults to the app from `pnpm dev`.
# PUBLIC_APP_URL=http://localhost:3000
# Canonical URL used by Astro. Defaults to the local landing-page server.
# PUBLIC_SITE_URL=http://localhost:4321
# Set both URLs explicitly for a production build, for example:
# PUBLIC_APP_URL=https://chat.example.com
# PUBLIC_SITE_URL=https://example.com
