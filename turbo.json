{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "LICENSE",
    "NOTICE",
    "scripts/third-party-notices.mjs",
    "pnpm-lock.yaml",
    "apps/landing/.env"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["PUBLIC_APP_URL", "PUBLIC_SITE_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["CLERK_*", "AI_*", "OPENAI_*", "ANTHROPIC_*", "MCP_*", "WRANGLER_*"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "@walden/api#build": {
      "dependsOn": ["^build", "@walden/web#build"],
      "outputs": ["dist/**"]
    }
  }
}
