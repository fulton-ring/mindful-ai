# Copy to .env.self-hosted. Never put this file in an image or version control.
APP_URL=http://localhost:3000
AUTH_MODE=none
# Optional limits/features. No billing, plans, Clerk or Stripe setup is required.
# Null means unlimited / never expire. Omit this to keep the existing defaults.
# APP_POLICY_JSON='{"messages":{"limit":null},"uploads":{"maxBytes":null,"maxFiles":null},"retention":{"idleDays":null}}'
# Chat accepts any configured OpenAI-compatible service, including a local server.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://host.docker.internal:11434/v1
# AI_MODEL=your-installed-model
# AI_API_KEY=your-service-key-if-required
# AI_BACKGROUND_MODEL=your-installed-background-model
# Explicit catalog for endpoints without /models (include all selected model IDs):
# AI_MODELS_JSON='["your-installed-model","your-installed-background-model"]'
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-openrouter-key
# Optional built-in email/password authentication:
# AUTH_MODE=better-auth
# BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# BETTER_AUTH_URL=http://localhost:3000
# Optional Clerk authentication (use keys from your own Clerk instance):
# AUTH_MODE=clerk
# CLERK_SECRET_KEY=sk_test_replace-me
# CLERK_PUBLISHABLE_KEY=pk_test_replace-me
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# For a standalone instance using external PostgreSQL (compose.external-postgres.yaml):
# DATABASE_URL=postgres://walden:password@postgres.example:5432/walden?sslmode=require
# Optional shared services for split roles or S3 storage:
# VALKEY_URL=rediss://:password@valkey.example:6379
# FILE_STORAGE=s3
# S3_ENDPOINT=https://s3.example
# S3_PUBLIC_ENDPOINT=https://s3.example
# S3_REGION=us-east-1
# S3_BUCKET=walden
# S3_ACCESS_KEY_ID=walden
# S3_SECRET_ACCESS_KEY=secret
# S3_FORCE_PATH_STYLE=false
# Local Compose postgres profile storage (read with --env-file .env.self-hosted):
# SEAWEEDFS_ACCESS_KEY_ID=replace-local-storage-key
# SEAWEEDFS_SECRET_ACCESS_KEY=replace-local-storage-secret
# SEAWEEDFS_PORT=8333
